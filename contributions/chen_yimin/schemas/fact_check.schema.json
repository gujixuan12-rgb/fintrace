{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinTrace Fact Check Output",
  "type": "object",
  "required": ["checked_claims", "passed_claims", "review_required_claims", "results", "issues"],
  "properties": {
    "document_name": {"type": ["string", "null"]},
    "checked_claims": {"type": "integer", "minimum": 0},
    "passed_claims": {"type": "integer", "minimum": 0},
    "review_required_claims": {"type": "integer", "minimum": 0},
    "results": {"type": "array"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "code", "severity", "message"],
        "properties": {
          "claim_id": {"type": "string"},
          "code": {"type": "string"},
          "severity": {"enum": ["ERROR", "WARNING"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
